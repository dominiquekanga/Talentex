# Configuration de la base de données PostgreSQL
DATABASE_URL="postgresql://username:password@localhost:5432/talenteex"

# Configuration JWT
JWT_SECRET="votre-secret-jwt-super-securise-changez-cela-en-production"
JWT_EXPIRES_IN="7d"

# Configuration Cloudinary pour les fichiers
CLOUDINARY_CLOUD_NAME="votre-cloud-name"
CLOUDINARY_API_KEY="votre-api-key"
CLOUDINARY_API_SECRET="votre-api-secret"

# Configuration Stripe pour les paiements
STRIPE_SECRET_KEY="sk_test_votre-cle-secrete-stripe"
STRIPE_WEBHOOK_SECRET="whsec_votre-webhook-secret"
STRIPE_COMMISSION_PERCENTAGE=10

# Configuration Email (SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="votre-email@gmail.com"
SMTP_PASS="votre-mot-de-passe-app"
SMTP_FROM="noreply@talenteex.com"

# Configuration du serveur
PORT=5050
NODE_ENV=development
CORS_ORIGIN="http://localhost:3000"

# Configuration de sécurité
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Configuration des fichiers
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES="image/jpeg,image/png,image/webp,application/pdf,video/mp4"

# Configuration de l'application
APP_NAME="TalentEx"
APP_URL="http://localhost:3000"
API_BASE_URL="http://localhost:5050/api" 